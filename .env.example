# Copiar a .env.local. Nunca publicar credenciales privadas.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# true: catálogo de ejemplo. false: exige Supabase y lee sus tablas.
FARMACOVA_DEMO_MODE=true
# Apple Wallet: SOLO variables privadas del servidor / Vercel.
# PEM convertido a base64 (certificado Pass Type ID, clave privada y WWDR).
SITE_URL=https://farmacova.com
APPLE_WALLET_PASS_TYPE_ID=pass.com.farmacova.fidelidad
APPLE_WALLET_TEAM_ID=
APPLE_WALLET_CERT_BASE64=
APPLE_WALLET_KEY_BASE64=
APPLE_WALLET_KEY_PASSPHRASE=
APPLE_WALLET_WWDR_BASE64=
